{
  "name": "sendy",
  "private": true,
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "drizzle-orm": "^0.38.3",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "typescript": "^5.7.2",
      "@types/node": "^22.10.2",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "@types/bun": "latest",
      "bullmq": "^5.0.0"
    }
  },
  "scripts": {
    "dev": "bun run --filter @sendy/web dev",
    "db:generate": "bun run --filter @sendy/db generate",
    "db:migrate": "bun run --filter @sendy/db migrate",
    "db:push": "bun run --filter @sendy/db push"
  }
}
